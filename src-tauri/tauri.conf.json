{
  "productName": "sfeedo",
  "version": "0.1.0",
  "identifier": "com.codingthings.sfeedo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "sfeedo",
        "width": 400,
        "height": 1000,
        "minWidth": 300,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ]
  }
}
